      "required": false,
      "default": "",
      "help": "Si conoces apps similares, las usaré como referencia para sugerir features y patrones de UX. Si no, escribe `ninguno` o déjalo vacío.",
      "example": "Notion, Trello, Linear",
      "modes": [
        "mvp",
        "serio"
