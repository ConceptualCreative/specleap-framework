{
  "metadata": {
    "version": "1.0",
    "total_questions": 93,
    "checkpoint_interval": 10,
    "description": "Interactive questionnaire to generate CONTRATO.md in SpecLeap"
  },
  "questions": [
    {
      "id": "project.type",
      "number": 1,
      "section": "Project Type",
      "text": "What kind of project is this?",
      "type": "select",
      "options": [
        "nuevo",
        "existente"
      ],
      "required": true,
      "help": "nuevo = from scratch | existente = adopt a legacy project into SpecLeap",
      "example": "nuevo",
      "modes": [
        "mvp",
        "serio"
      ]
    },
    {
      "id": "project.path",
      "number": 2,
      "section": "Project Type",
      "text": "Path to the existing project?",
      "type": "string",
      "required": false,
      "skip_if": {
        "project.type": "nuevo"
      },
      "help": "Absolute or relative path to the legacy project directory",
      "example": "/Users/me/my-legacy-project",
      "modes": [
        "mvp",
        "serio"
      ]
    },
    {
      "id": "project.name",
      "number": 3,
      "section": "Project Information",
      "text": "Project name? (slug-style: lowercase, numbers and hyphens only)",
      "type": "string",
      "validation": {
        "pattern": "^[a-z0-9-]+$",
        "min_length": 3,
        "max_length": 50
      },
      "required": true,
      "default": null,
      "help": "Examples: task-manager, inventory-app, crm-suite",
      "example": "task-manager",
      "modes": [
        "mvp",
        "serio"
      ]
    },
    {
      "id": "project.display_name",
      "number": 4,
      "section": "Project Information",
      "text": "Full display name?",
      "type": "string",
      "validation": {
        "min_length": 3,
        "max_length": 100
      },
      "required": true,
      "default": null,
      "help": "The name users will see. Can have uppercase, spaces and special characters.",
      "example": "Task Manager Pro",
      "modes": [
        "mvp",
        "serio"
      ]
    },
    {
      "id": "project.responsible",
      "number": 5,
      "section": "Project Information",
      "text": "Who owns this project?",
      "type": "string",
      "required": true,
      "default": null,
      "help": "Name of the product owner, tech lead or main person in charge.",
      "example": "Alex Smith",
      "modes": [
        "mvp",
        "serio"
      ]
    },
    {
      "id": "identity.objective",
      "number": 6,
      "section": "Project Identity",
      "text": "What does this project do? (1-2 sentences, max 200 characters)",
      "type": "text",
      "validation": {
        "max_length": 200
      },
      "required": true,
      "help": "Brief description of the main purpose.",
      "example": "Web app to manage team tasks with assignments, priorities and time tracking",
      "modes": [
        "mvp",
        "serio"
      ]
    },
    {
      "id": "identity.problem_solved",
      "number": 7,
      "section": "Project Identity",
      "text": "What problem does it solve?",
      "type": "text",
      "validation": {
        "max_length": 300
      },
      "required": true,
      "help": "The pain point or need your project addresses.",
      "example": "Teams waste time coordinating tasks across scattered tools (email, chat, spreadsheets) and lack clear visibility into progress",
      "modes": [
        "mvp",
        "serio"
      ]
    },
    {
      "id": "identity.target_audience",
      "number": 8,
      "section": "Project Identity",
      "text": "Who is the target user?",
      "type": "select",
      "options": [
        "personal",
        "team",
        "public",
        "niche"
      ],
      "required": true,
      "help": "personal = just you | team = your team | public = anyone | niche = specific audience",
      "example": "public",
      "modes": [
        "mvp",
        "serio"
      ]
    },
    {
      "id": "identity.competitors",
      "number": 9,
      "section": "Project Identity",
      "text": "References or competitors? (optional, comma-separated)",
      "type": "string",
      "required": false,
      "default": "",
      "help": "If you know similar apps, I'll use them as a reference to suggest features and UX patterns. If none, type `none` or leave blank.",
      "example": "Notion, Trello, Linear",
      "modes": [
        "mvp",
        "serio"
      ]
    },
    {
