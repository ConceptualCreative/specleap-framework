#!/usr/bin/env node

const { spawn, execSync } = require('child_process');
const path = require('path');
const fs = require('fs');
const readline = require('readline');
const os = require('os');

// Nombre por defecto de la carpeta destino. El usuario puede cambiarlo
// en el prompt; si pulsa Enter, se usa este valor.
const DEFAULT_FOLDER_NAME = 'specleap-framework';

// Validador de nombre de carpeta: caracteres seguros para sistemas de
// archivos cross-platform (sin `/`, sin nulos, sin barras). Permite letras,
// números, guiones, guiones bajos y puntos. No puede empezar con punto.
function isValidFolderName(name) {
  if (!name || name.length === 0) return false;
  if (name.length > 100) return false;
  if (name.startsWith('.')) return false;
  return /^[A-Za-z0-9_][A-Za-z0-9_.\-]*$/.test(name);
}

// Directorio del paquete npm (donde están todos los archivos a copiar)
const packageDir = path.join(__dirname, '..');

// Resolver una ruta base introducida por el usuario:
// - "~" o "~/algo" → expande a $HOME
// - relativa → se resuelve contra cwd
// - absoluta → se queda igual
function resolveBasePath(input) {
  const trimmed = input.trim();
  if (!trimmed) return process.cwd();
  if (trimmed === '~') return os.homedir();
  if (trimmed.startsWith('~/')) return path.join(os.homedir(), trimmed.slice(2));
  if (path.isAbsolute(trimmed)) return trimmed;
  return path.resolve(process.cwd(), trimmed);
}

// Copia recursiva cross-platform usando la API nativa de Node (fs.cpSync,
// estable desde Node 16.7; engines exige >=18). No depende de `cp` de Unix.
// La copia que recibe el usuario no incluye dependencias, secretos, cachés
// ni proyectos locales: eso vive en el checkout de quien publica, no en
// la instalación.
const SKIP_DIR_NAMES = new Set([
  'node_modules', '.git', '__pycache__', 'kofi-images', 'dist', 'build',
  'coverage', 'tmp', 'temp'
]);

function shouldCopy(src) {
  const base = path.basename(src);
  if (SKIP_DIR_NAMES.has(base)) return false;
  if (base === '.DS_Store' || base === 'Thumbs.db') return false;
  if (base === 'NPM_PUBLISH.md' || base === 'test-install.sh' || base === '.npmignore') return false;
  if (base.endsWith('.pyc') || base.endsWith('.log') || base.endsWith('.tgz')) return false;
  if (base === '.env' || base.startsWith('.env.')) return false;

  const norm = src.split(path.sep).join('/');
  if (norm.endsWith('/.specleap/config.json')) return false;
  if (norm.endsWith('/.quality/evidence') || norm.includes('/.quality/evidence/')) return false;
  if (norm.includes('/proyectos/') && !norm.includes('/proyectos/_template')) return false;
  return true;
}

function copyTree(srcDir, destDir) {
  fs.cpSync(srcDir, destDir, {
    recursive: true,
    filter: shouldCopy
  });
}

// Localiza un intérprete bash cross-platform para ejecutar setup.sh.
// - macOS/Linux: `bash` del PATH (comportamiento de siempre).
// - Windows: Git Bash (incluido en Git para Windows). NO usamos WSL como
//   fallback a propósito: WSL traduce rutas a /mnt/c/... y romperíamos al
//   pasarle una ruta Windows; es preferible un mensaje claro a un fallo opaco.
// Devuelve la ruta/comando del binario bash, o null si no hay ninguno.
function findBash() {
  if (process.platform !== 'win32') {
    return 'bash';
  }

  // Candidatos típicos de Git para Windows (incluye Git Bash).
  const programFiles = [
    process.env['ProgramW6432'],
    process.env['ProgramFiles'],
    process.env['ProgramFiles(x86)'],
    'C:\\Program Files',
    'C:\\Program Files (x86)'
  ].filter(Boolean);

  const candidates = [];
  for (const pf of programFiles) {
    candidates.push(path.join(pf, 'Git', 'bin', 'bash.exe'));
    candidates.push(path.join(pf, 'Git', 'usr', 'bin', 'bash.exe'));
  }

  for (const candidate of candidates) {
    if (fs.existsSync(candidate)) return candidate;
  }

  // Fallback: derivar bash a partir de git.exe.
  // Git para Windows coloca git.exe en <Git>\cmd o en <Git>\bin.
  // Si solo subimos dos niveles, el caso <Git>\bin\git.exe apunta al padre
  // de Git y no encuentra bash.
  try {
    const gitPath = execSync('where git', { stdio: ['ignore', 'pipe', 'ignore'] })
      .toString()
      .split(/\r?\n/)[0]
      .trim()
      .replace(/^"|"$/g, '');
    if (gitPath) {
      const gitDir = path.dirname(gitPath);
      const gitRoot = path.dirname(gitDir);
      const derived = [
        path.join(gitRoot, 'bin', 'bash.exe'),
        path.join(gitRoot, 'usr', 'bin', 'bash.exe'),
        path.join(gitDir, 'bash.exe')
      ];
      for (const candidate of derived) {
        if (fs.existsSync(candidate)) return candidate;
      }
    }
  } catch (_) {
    // git no está en PATH; no hay forma fiable de localizar bash.
  }

  return null;
}

// Crea una interfaz readline reutilizable; cerramos al final del flujo.
function createPrompt() {
  return readline.createInterface({
    input: process.stdin,
    output: process.stdout
  });
}

function ask(rl, question) {
  return new Promise((resolve) => rl.question(question, (a) => resolve(a)));
}

// Pregunta la carpeta base donde poner el proyecto. Bilingüe porque el
// idioma de SpecLeap se elige después dentro de setup.sh.
async function askBasePath(rl, defaultBase) {
  console.log('');
  console.log('📁 ¿En qué carpeta base instalar SpecLeap?');
  console.log('   Where do you want to install SpecLeap?');
  console.log('');
  console.log(`   Default: ${defaultBase}`);
  console.log('');
  console.log('   Ejemplos / Examples:');
  console.log('     ~/Downloads        →  ~/Downloads/<nombre>');
  console.log('     ~/Desktop/work     →  ~/Desktop/work/<nombre>');
  console.log('     .                  →  ./<nombre>');
  console.log('     (Enter)            →  default arriba');
  console.log('');

  const answer = await ask(rl, 'Carpeta base / Base folder: ');
  return resolveBasePath(answer);
}

// Pregunta el nombre de la carpeta. Default = "specleap-framework".
// Reintenta si el nombre tiene caracteres inválidos.
async function askFolderName(rl) {
  console.log('');
  console.log('📝 ¿Qué nombre quieres para la carpeta?');
  console.log('   What name do you want for the folder?');
  console.log('');
  console.log(`   Default: ${DEFAULT_FOLDER_NAME}`);
  console.log('   Permitido / Allowed: letras, números, guiones, guiones bajos, puntos');
  console.log('   No permitido / Not allowed: espacios, "/", caracteres especiales');
  console.log('');

  while (true) {
    const answer = await ask(rl, 'Nombre / Name: ');
    const name = answer.trim();

    // Enter → default
    if (!name) return DEFAULT_FOLDER_NAME;

    if (isValidFolderName(name)) return name;

    console.log('');
    console.log(`❌ Nombre inválido / Invalid name: "${name}"`);
    console.log('   Usa solo letras, números, "-", "_" y "." (sin empezar con ".")');
    console.log('   Use only letters, numbers, "-", "_" and "." (cannot start with ".")');
    console.log('');
  }
}

async function main() {
  // Argumentos CLI opcionales:
  //   npx specleap-framework@latest <carpeta-base> [<nombre>]
  //   p.ej.  npx specleap-framework@latest ~/Downloads
  //          npx specleap-framework@latest ~/Downloads mi-app
  const rawArgs = process.argv.slice(2);

  // Modo `--here`: ejecuta setup.sh en el directorio actual sin copiar nada.
  // Lo usa `npm run setup` (vía git clone) para arrancar la configuración de
  // forma cross-platform, localizando bash igual que el flujo npx.
  if (rawArgs.includes('--here')) {
    const setupPath = path.join(process.cwd(), 'setup.sh');
    if (!fs.existsSync(setupPath)) {
      console.error('\n❌ setup.sh no encontrado en el directorio actual.');
      console.error('   setup.sh not found in the current directory.\n');
      process.exit(1);
    }
    const bashBin = findBash();
    if (!bashBin) {
      console.error('\n❌ No se encontró bash / bash not found.');
      console.error('   SpecLeap necesita bash para la configuración inicial.');
      console.error('   SpecLeap needs bash to run the initial setup.\n');
      console.error('   Windows: instala Git para Windows (incluye Git Bash):');
      console.error('            install Git for Windows (includes Git Bash):');
      console.error('            https://git-scm.com/download/win\n');
      console.error('   Después / Then:  bash setup.sh\n');
      process.exit(1);
    }
    const setup = spawn(bashBin, [setupPath], {
      stdio: 'inherit',
      cwd: process.cwd(),
      env: { ...process.env, SPECLEAP_INSTALL_PATH: process.cwd() }
    });
    setup.on('close', (code) => process.exit(code));
    return;
  }

  const args = rawArgs.filter((a) => !a.startsWith('-'));
  const argBase = args[0];
  const argName = args[1];

  // Validar el nombre del argumento CLI antes de seguir
  if (argName && !isValidFolderName(argName)) {
    console.error(`\n❌ Nombre inválido / Invalid name: "${argName}"`);
    console.error('   Usa solo letras, números, "-", "_" y "." (sin empezar con ".")');
    console.error('   Use only letters, numbers, "-", "_" and "." (cannot start with ".")\n');
    process.exit(1);
  }

  // Si hay argumentos CLI, no abrimos prompt; si faltan, preguntamos
  let basePath, folderName;
  const rl = (!argBase || !argName) ? createPrompt() : null;

  try {
    if (argBase) {
      basePath = resolveBasePath(argBase);
      console.log(`\n📁 Carpeta base: ${basePath}`);
    } else {
      basePath = await askBasePath(rl, process.cwd());
    }

    if (argName) {
      folderName = argName;
      console.log(`📝 Nombre de carpeta: ${folderName}`);
    } else {
      folderName = await askFolderName(rl);
    }
  } finally {
    if (rl) rl.close();
  }

  // Verificar que la carpeta base existe (o se puede crear)
  if (!fs.existsSync(basePath)) {
    try {
      fs.mkdirSync(basePath, { recursive: true });
      console.log(`📂 Carpeta base creada / Base folder created: ${basePath}`);
    } catch (err) {
      console.error(`\n❌ No se pudo crear la carpeta base / Could not create base folder: ${basePath}`);
      console.error(`   ${err.message}\n`);
      process.exit(1);
    }
  }

  const baseStat = fs.statSync(basePath);
  if (!baseStat.isDirectory()) {
    console.error(`\n❌ La ruta no es una carpeta / Path is not a directory: ${basePath}\n`);
    process.exit(1);
  }

  // Destino final: <basePath>/<folderName>
  const targetDir = path.join(basePath, folderName);

  // No sobrescribir si ya existe
  if (fs.existsSync(targetDir)) {
    console.error(`\n❌ Ya existe / Already exists: ${targetDir}`);
    console.error('   Elige otra carpeta o nombre, o elimina la existente.');
    console.error('   Choose another folder or name, or delete the existing one.\n');
    process.exit(1);
  }

  console.log(`\n🚀 Copiando SpecLeap Framework a / Copying SpecLeap Framework to:`);
  console.log(`   ${targetDir}\n`);

  // Crear destino y copiar archivos (copia cross-platform con Node, sin `cp`).
  try {
    fs.mkdirSync(targetDir, { recursive: true });
    copyTree(packageDir, targetDir);
    console.log(`✅ Archivos copiados / Files copied\n`);
  } catch (err) {
    console.error('❌ Error copiando archivos / Error copying files:', err.message);
    process.exit(1);
  }

  // Ejecutar setup.sh DESDE el directorio copiado, exportando la ruta
  // para que setup.sh la use en el mensaje final.
  const setupPath = path.join(targetDir, 'setup.sh');

  // Localizar bash de forma cross-platform. En Windows esto resuelve a Git
  // Bash; si no hay ninguno, los archivos ya están copiados pero no podemos
  // ejecutar setup.sh, así que damos instrucciones claras.
  const bashBin = findBash();
  if (!bashBin) {
    console.error('\n❌ No se encontró bash / bash not found.');
    console.error('   Los archivos se copiaron en / Files were copied to:');
    console.error(`   ${targetDir}\n`);
    console.error('   SpecLeap necesita bash para la configuración inicial.');
    console.error('   SpecLeap needs bash to run the initial setup.\n');
    console.error('   Windows: instala Git para Windows (incluye Git Bash):');
    console.error('            install Git for Windows (includes Git Bash):');
    console.error('            https://git-scm.com/download/win\n');
    console.error('   Después, en una terminal Git Bash / Then, in a Git Bash terminal:');
    console.error(`     cd "${targetDir}"`);
    console.error('     bash setup.sh\n');
    process.exit(1);
  }

  const setup = spawn(bashBin, [setupPath], {
    stdio: 'inherit',
    cwd: targetDir,
    env: {
      ...process.env,
      SPECLEAP_INSTALL_PATH: targetDir,
      // El nombre ya se pidió antes de copiar. setup.sh no debe volver a
      // preguntarlo ni intentar renombrar esta carpeta.
      SPECLEAP_SKIP_FOLDER_PROMPT: '1'
    }
  });

  setup.on('close', (code) => {
    process.exit(code);
  });
}

main().catch((err) => {
  console.error('\n❌ Error inesperado / Unexpected error:', err.message);
  process.exit(1);
});
